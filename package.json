{
  "name": "@unreleased/hellojs",
  "version": "0.2.5",
  "description": "Custom TLS 1.3 + HTTP/2 + HTTP/3 client mimicking the Chrome 147 fingerprint, with a request.js-shape API.",
  "main": "index.js",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:fingerprint": "node test/fingerprint/chrome147.js",
    "test:integration": "node test/integration/httpbin.js && node test/integration/multi-server.js && node test/integration/api.js",
    "test:soak": "node --expose-gc test/soak/soak.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:types": "./node_modules/.bin/tsc --project test/types/tsconfig.json",
    "example": "node examples/basic.js",
    "prepublishOnly": "node --input-type=module -e \"await import('./index.js')\""
  },
  "keywords": [
    "tls",
    "tls13",
    "http2",
    "http3",
    "quic",
    "fingerprint",
    "ja4",
    "chrome",
    "request",
    "mlkem",
    "x25519mlkem768"
  ],
  "author": "Conor Reid <hello@conorre.id>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unreleased/hellojs.git"
  },
  "bugs": {
    "url": "https://github.com/unreleased/hellojs/issues"
  },
  "homepage": "https://github.com/unreleased/hellojs#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
