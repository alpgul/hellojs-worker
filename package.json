{
  "name": "@unreleased/hellojs",
  "version": "0.2.5",
  "description": "Custom TLS 1.3 + HTTP/2 + HTTP/3 client mimicking the Chrome 147 fingerprint, with a request.js-shape API.",
  "main": "index.ts",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "index.ts",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "vitest run --project=workers --project=node",
    "test:watch": "vitest --project=workers --project=node",
    "test:workers": "vitest run --project=workers",
    "test:node": "vitest run --project=node",
    "test:network": "vitest run --project=network",
    "test:all": "vitest run",
    "test:fingerprint": "vitest run --project=network test/fingerprint",
    "test:integration": "vitest run --project=network test/integration",
    "test:soak": "vitest run --project=node test/soak",
    "bench": "node test/bench/clients.ts",
    "bench:remote": "node test/bench/clients.ts --remote-only",
    "bench:h3": "node test/bench/h3-vs-h2.ts",
    "bench:vs-got": "node test/bench/vs-got-h2.ts",
    "bench:vs-axios": "node test/bench/vs-axios.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc --project tsconfig.build.json",
    "prebuild": "npm run clean",
    "typecheck": "tsc --noEmit",
    "test:types": "./node_modules/.bin/tsc --project test/types/tsconfig.json",
    "example": "wrangler dev",
    "example:node": "node examples/node.ts",
    "prepublishOnly": "node --input-type=module -e \"await import('./index.ts')\""
  },
  "keywords": [
    "tls",
    "tls13",
    "http2",
    "http3",
    "quic",
    "fingerprint",
    "ja4",
    "chrome",
    "request",
    "mlkem",
    "x25519mlkem768"
  ],
  "author": "Conor Reid <hello@conorre.id>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unreleased/hellojs.git"
  },
  "bugs": {
    "url": "https://github.com/unreleased/hellojs/issues"
  },
  "homepage": "https://github.com/unreleased/hellojs#readme",
  "engines": {
    "node": ">=24.21.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "axios": "^1.21.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "got": "^16.1.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "undici": "^8.12.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0"
  }
}
